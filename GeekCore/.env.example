# Copie este arquivo para ".env" (minúsculo) e preencha os valores.
# Nunca faça commit do .env.

# MongoDB Atlas: Connect > Drivers. Mantenha o nome do banco (/conteudo) antes do "?".
MONGO_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/conteudo?retryWrites=true&w=majority

# Gere um valor aleatório, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3001
REACT_APP_API_PORT=3001
REACT_APP_API_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001
